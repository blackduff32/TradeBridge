# Run npm run setup to generate per-principal development credentials.
# Never use these static bearer-token identities as production staff authentication.
TRADEBRIDGE_PRINCIPALS=
TRADEBRIDGE_DB=data/tradebridge.db
PORT=3100
TRADEBRIDGE_DEMO=true

# Optional World ID integration. Keep these unset until an app exists.
# WORLD_APP_ID=app_...
# WORLD_RP_ID=rp_...
# WORLD_ACTION=tradebridge-approval   (prefix; each candidate version gets its own action)
# WORLD_ENVIRONMENT=staging
# WORLD_SIGNING_KEY=<private RP signing key; never expose in web variables>
# WORLD_STAGING_VERIFICATION_TOKEN=<staging only: token from a 24-hour staging verification window; production needs none>
# Configuration enables the proof request/verification path, not trade approval.

# DEMO ONLY: a static roster of one buyer and one broker approver, staging World ID only.
# It stands in for staff enrollment and trusted presence. See docs/INTEGRATIONS.md.
# TRADEBRIDGE_DEMO_APPROVERS=buyer-human,broker-human

# Optional: run a second checkout beside the default one (PORT is the API port).
# TRADEBRIDGE_WEB_PORT=5173

# Optional explicit agent runs; never sent to the browser.
# OPENAI_API_KEY=
# TRADEBRIDGE_MODEL=gpt-6-luna
# TRADEBRIDGE_REASONING_EFFORT=low   (none, low, medium, high, xhigh or max; "off" for a model that does not reason)
